{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event.schema.json",
  "title": "Civil War Event",
  "description": "Schema for Civil War events (battles, sieges, treaties, etc.)",
  "type": "object",
  "required": ["id", "name", "type", "date_start"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the event"
    },
    "source_id": {
      "type": "string",
      "description": "Original ID from the data source"
    },
    "source": {
      "type": "string",
      "description": "Data source name (e.g., 'acw_battle_data', 'wikidata', 'nps')"
    },
    "name": {
      "type": "string",
      "description": "Name of the event"
    },
    "alternate_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternative names for the event"
    },
    "type": {
      "type": "string",
      "enum": ["battle", "siege", "raid", "skirmish", "treaty", "election", "proclamation", "surrender", "other"],
      "description": "Type of event"
    },
    "date_start": {
      "type": "string",
      "format": "date",
      "description": "Start date in ISO 8601 format (YYYY-MM-DD)"
    },
    "date_end": {
      "type": ["string", "null"],
      "format": "date",
      "description": "End date in ISO 8601 format (YYYY-MM-DD)"
    },
    "description": {
      "type": ["string", "null"],
      "description": "Description of the event"
    },
    "location": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "state": { "type": ["string", "null"] },
        "county": { "type": ["string", "null"] }
      },
      "required": ["name"]
    },
    "theater": {
      "type": ["string", "null"],
      "description": "Theater of operations (Eastern, Western, Trans-Mississippi, etc.)"
    },
    "campaign": {
      "type": ["string", "null"],
      "description": "Military campaign this event was part of"
    },
    "casualties": {
      "type": ["object", "null"],
      "properties": {
        "union": { "$ref": "#/definitions/casualtyStats" },
        "confederate": { "$ref": "#/definitions/casualtyStats" }
      }
    },
    "forces": {
      "type": ["object", "null"],
      "properties": {
        "union": { "$ref": "#/definitions/forceStats" },
        "confederate": { "$ref": "#/definitions/forceStats" }
      }
    },
    "commanders": {
      "type": ["object", "null"],
      "properties": {
        "union": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confederate": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "result": {
      "type": ["string", "null"],
      "description": "Outcome of the event (Union victory, Confederate victory, Inconclusive, etc.)"
    },
    "significance": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5,
      "description": "Historical significance rating (1-5, with 5 being most significant)"
    },
    "cwsac_id": {
      "type": ["string", "null"],
      "description": "Civil War Sites Advisory Commission ID"
    },
    "wikipedia_url": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Wikipedia article URL"
    },
    "wikidata_id": {
      "type": ["string", "null"],
      "description": "Wikidata entity ID (e.g., Q123456)"
    },
    "image_url": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "URL to an image representing the event"
    }
  },
  "definitions": {
    "casualtyStats": {
      "type": "object",
      "properties": {
        "killed": { "type": ["integer", "null"], "minimum": 0 },
        "wounded": { "type": ["integer", "null"], "minimum": 0 },
        "captured": { "type": ["integer", "null"], "minimum": 0 },
        "missing": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "forceStats": {
      "type": "object",
      "properties": {
        "strength": { "type": ["integer", "null"], "minimum": 0 },
        "units": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    }
  }
}
